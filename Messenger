import socket
import threading
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.scrollview import ScrollView
from kivy.uix.label import Label
from kivy.clock import Clock

# Сетевые порты для P2P-соединения
UDP_PORT = 50000
TCP_PORT = 50001


class MessengerLayout(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', padding=10, spacing=10, **kwargs)

        # 1. История сообщений (Скроллируемая область)
        self.scroll = ScrollView(size_hint=(1, 0.85))
        self.chat_history = Label(
            size_hint_y=None,
            markup=True,
            valign='top',
            halign='left',
            text="[b]Мессенджер запущен.[/b] Поиск собеседников в локальной сети...\n"
        )
        
        # Динамический расчет высоты и переноса строк для Kivy Label
        self.chat_history.bind(texture_size=self._update_label_height)
        self.bind(width=self._update_text_width)
        
        self.scroll.add_widget(self.chat_history)
        self.add_widget(self.scroll)

        # 2. Панель ввода (Поле + Кнопка)
        input_layout = BoxLayout(orientation='horizontal', size_hint=(1, 0.15), spacing=10)
        
        self.message_input = TextInput(
            hint_text="Введите сообщение...",
            multiline=False,
            size_hint=(0.8, 1)
        )
        self.message_input.bind(on_text_validate=self.send_message)
        
        send_btn = Button(
            text="Отправить",
            size_hint=(0.2, 1),
            background_color=(0.2, 0.6, 1, 1)
        )
        send_btn.bind(on_release=self.send_message)

        input_layout.add_widget(self.message_input)
        input_layout.add_widget(send_btn)
        self.add_widget(input_layout)

        # Список обнаруженных IP-адресов в сети
        self.peers = set()

        # Запуск фоновых сетевых служб
        threading.Thread(target=self.start_tcp_server, daemon=True).start()
        threading.Thread(target=self.start_udp_beacon, daemon=True).start()
        threading.Thread(target=self.start_udp_listener, daemon=True).start()

    def _update_label_height(self, instance, value):
        instance.height = value[1]

    def _update_text_width(self, instance, value):
        self.chat_history.text_size = (value - 20, None)

    def append_message(self, text):
        """Безопасный вывод текста в чат из любого фонового потока"""
        def update_text(dt):
            self.chat_history.text += text + "\n"
        Clock.schedule_once(update_text)

    def send_message(self, instance):
        msg = self.message_input.text.strip()
        if not msg:
            return

        self.append_message(f"[color=3388ff][b]Вы:[/b][/color] {msg}")
        self.message_input.text = ""

        # Отправка сообщения всем подключенным узлам
        for peer_ip in list(self.peers):
            threading.Thread(target=self._send_to_peer, args=(peer_ip, msg), daemon=True).start()

    def _send_to_peer(self, ip, msg):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(3.0)
            s.connect((ip, TCP_PORT))
            s.sendall(msg.encode('utf-8'))
            s.close()
        except Exception:
            pass

    def start_tcp_server(self):
        """Сервер для приема входящих личных сообщений"""
        server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        server.bind(('0.0.0.0', TCP_PORT))
        server.listen(5)

        while True:
            conn, addr = server.accept()
            data = conn.recv(2048)
            if data:
                text = data.decode('utf-8', errors='ignore')
                self.append_message(f"[color=22aa22][b]{addr[0]}:[/b][/color] {text}")
            conn.close()

    def start_udp_beacon(self):
        """Периодическая рассылка сигналов для автообнаружения устрoйств"""
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        while True:
            try:
                sock.sendto(b"DISCOVER_MESSENGER", ('<broadcast>', UDP_PORT))
            except Exception:
                pass
            threading.Event().wait(3.0)

    def start_udp_listener(self):
        """Прослушивание локальной сети на наличие других участников"""
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(('0.0.0.0', UDP_PORT))

        try:
            my_ip = socket.gethostbyname(socket.gethostname())
        except Exception:
            my_ip = "127.0.0.1"

        while True:
            data, addr = sock.recvfrom(1024)
            if data == b"DISCOVER_MESSENGER" and addr[0] != my_ip:
                if addr[0] not in self.peers:
                    self.peers.add(addr[0])
                    self.append_message(f"[size=12][color=888888]Подключен пользователь: {addr[0]}[/color][/size]")


class MessengerApp(App):
    def build(self):
        self.title = "Local P2P Messenger"
        return MessengerLayout()


if __name__ == '__main__':
    MessengerApp().run()
